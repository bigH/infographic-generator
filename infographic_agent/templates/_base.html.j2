<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: {{ canvas_width }}px;
    height: {{ canvas_height }}px;
    overflow: hidden;
    font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
    background: #ffffff;
    color: #1a1a1a;
  }
  .canvas {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  {{ template_css }}
</style>
</head>
<body>
  <div class="canvas">
    {% block content %}{% endblock %}
  </div>
</body>
</html>
