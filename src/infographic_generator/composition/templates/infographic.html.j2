{#-
  Specimen-sheet layout. Ink masthead with the hero punched into it, a ledger of
  statistics set two to a line and broken by inverted "patch" rows, prose set as
  side-heads, and an attribution colophon.

  Rendered by an Environment with autoescape=True, which escapes for HTML and
  *not* for CSS. So: nothing researched, scraped or user-supplied may be
  interpolated into the <style> element or into a style="" attribute. The only
  values that go there are numbers this package computed itself -- the page
  width, the gutter, `figure.aspect`, `stat.fit` -- and the base64 font and image
  payloads, whose alphabet cannot escape a CSS string.
-#}
{%- macro band(figures) -%}
<section class="band gutter">
  {% for figure in figures %}
  <figure style="flex: {{ figure.aspect }} 1 0">
    <img src="{{ figure.data_uri }}" alt="{{ figure.alt }}" style="aspect-ratio: {{ figure.aspect }}">
    <figcaption>{{ figure.caption }}</figcaption>
  </figure>
  {% endfor %}
</section>
{%- endmacro -%}
<!doctype html>
<html lang="{{ page.lang }}" dir="{{ page.direction }}" data-theme="{{ page.theme }}">
<head>
<meta charset="utf-8">
<title>{{ page.title }}</title>
<style>
{% for face in page.fonts %}
@font-face {
  font-family: "{{ face.family }}";
  font-style: {{ face.style }};
  font-weight: {{ face.weight }};
  font-display: block;
  src: url({{ face.data_uri }}) format("woff2");
}
{% endfor %}

:root {
  --w: {{ page.width_px }}px;
  --pad: {{ page.gutter_px }}px;

  /* Embedded faces first, then nothing but CSS generics. Naming a real family
     here -- Georgia, Menlo, DejaVu Sans Mono -- would put the render back at the
     mercy of what happens to be installed. The generics are only ever reached
     for glyphs outside the embedded latin subsets. */
  --display: "Ledger Slab", ui-serif, serif;
  --body: "Ledger Text", ui-serif, serif;
  --data: "Ledger Mono", ui-monospace, monospace;

  /* One display ramp: eight rungs from 27px at a ratio of 1.23. Every large size
     below picks a rung by role rather than inventing a number -- so not every rung
     is in use at once, and adding a role means choosing one, not adding one. */
  --s0: 27px;
  --s1: 33px;
  --s2: 41px;
  --s3: 50px;
  --s4: 62px;
  --s5: 76px;
  --s6: 94px;
  --s7: 116px;

  --paper: #eceae2;
  --patch: #17150f;
  --on-paper: #1a1712;
  --on-patch: #f1efe6;
  --dim-paper: #6a6558;
  --dim-patch: #a29e8d;
  --rule-paper: #c8c4b7;
  --rule-patch: #3b3729;
  --accent-paper: #5c6a12;
  --accent-patch: #bccb4e;
}
:root[data-theme="dark"] {
  --paper: #14130d;
  --patch: #eceae2;
  --on-paper: #eeece3;
  --on-patch: #17150f;
  --dim-paper: #8e8a79;
  --dim-patch: #6a6558;
  --rule-paper: #343024;
  --rule-patch: #c8c4b7;
  --accent-paper: #bccb4e;
  --accent-patch: #5c6a12;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { background: var(--paper); }
body {
  width: var(--w);
  background: var(--paper);
  color: var(--on-paper);
  font-family: var(--body);
  font-size: 16.5px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
{% if page.min_height_px %}
body { min-height: {{ page.min_height_px }}px; }
{% endif %}
/* Every image is constrained by CSS alone; the inline aspect-ratio governs its
   height, so nothing here may set one. */
img { display: block; width: 100%; height: auto; }
li { list-style: none; }

.gutter { padding-inline: var(--pad); }
.rule { height: 6px; background: var(--accent-paper); }

/* --- shared devices ------------------------------------------------ */
.tick {
  font-family: var(--data);
  font-size: 10.5px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  line-height: 1.5;
  border-inline-start: 2px solid var(--accent-paper);
  padding-inline-start: 9px;
  color: var(--dim-paper);
}
.on-ink .tick { border-inline-start-color: var(--accent-patch); color: var(--dim-patch); }

/* A display string is capped twice: --size is the editorial ceiling for its
   length, --fit is what its column can actually hold. The smaller wins, so
   narrowing the page shrinks type instead of wrapping it. */
.fitted { font-size: min(var(--size), var(--fit)); }

/* The display face defaults to old-style figures, which at 100px reads as a row
   of digits at four different heights. Lining and tabular throughout. */
.title, .row__value, .section__heading {
  font-variant-numeric: lining-nums tabular-nums;
}

/* --- masthead ------------------------------------------------------ */
.masthead {
  display: grid;
  grid-template-columns: 46fr 54fr;
  background: var(--patch);
  color: var(--on-patch);
}
.masthead--flat { grid-template-columns: 1fr; }
.masthead__text {
  container-type: inline-size;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 22px;
  min-height: 430px;
  padding-block: 54px 44px;
}
.masthead--flat .masthead__text { min-height: 0; padding-block: 68px 48px; }

.title {
  font-family: var(--display);
  font-weight: 700;
  line-height: 0.98;
  letter-spacing: -0.018em;
  text-wrap: balance;
}
.title--xl { --size: var(--s6); }
.title--l  { --size: var(--s5); }
.title--m  { --size: var(--s4); }
.title--s  { --size: var(--s3); }
.masthead--flat .title--xl { --size: var(--s7); }

.subtitle {
  max-width: 34ch;
  font-size: 20px;
  font-style: italic;
  line-height: 1.34;
  color: var(--dim-patch);
}
.masthead--flat .subtitle { max-width: 60ch; }

.hero { position: relative; overflow: hidden; }
/* The one deliberate crop on the page: the hero fills the masthead's height. */
.hero img { height: 100%; object-fit: cover; }
.hero__credit {
  position: absolute;
  inset-inline: 0;
  bottom: 0;
  padding: 24px 16px 9px;
  background: linear-gradient(to top, rgba(8, 7, 4, 0.78), rgba(8, 7, 4, 0));
  color: #eeeade;
  font-family: var(--data);
  font-size: 10.5px;
  letter-spacing: 0.06em;
  text-align: end;
}

/* --- lede ----------------------------------------------------------- */
.lede {
  background: var(--patch);
  color: var(--on-patch);
  padding-block: 30px 40px;
}
.lede p {
  max-width: 76ch;
  border-top: 1px solid var(--rule-patch);
  padding-top: 24px;
  font-size: 24px;
  line-height: 1.44;
}

/* --- ledger --------------------------------------------------------- */
/* Two stats to a line. Patch rows and a trailing orphan span both columns; the
   orphan spans so an odd count does not read as a mistake. */
.ledger {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: var(--pad);
  padding-inline: var(--pad);
}
.row {
  border-top: 1px solid var(--rule-paper);
  padding-block: 15px 20px;
}
/* A row that spans both columns has room to set its gloss beside the numeral
   rather than under it, bottom-aligned with it. `full_width` decides the split;
   `feature` decides the ink. */
.row--full {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  column-gap: var(--pad);
  align-items: end;
}
.row--full .row__detail { margin-top: 0; }
/* The query container is the label-and-value stack, not the whole row, so a
   value sized against it stays inside its own column however the row is split. */
.row__head { container-type: inline-size; }
.row__label {
  font-family: var(--data);
  font-size: 11px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  line-height: 1.5;
  color: var(--accent-paper);
}
.row__value {
  margin-top: 6px;
  font-family: var(--display);
  font-weight: 700;
  line-height: 0.94;
  letter-spacing: -0.02em;
  overflow-wrap: break-word;
}
.value--xl { --size: var(--s5); }
.value--l  { --size: var(--s4); }
.value--m  { --size: var(--s3); }
.value--s  { --size: var(--s2); }
.row__unit {
  font-family: var(--data);
  font-size: 0.3em;
  font-weight: 400;
  letter-spacing: 0.04em;
  margin-inline-start: 0.34em;
  color: var(--dim-paper);
}
.row__detail {
  margin-top: 12px;
  max-width: 72ch;
  font-size: 14.5px;
  line-height: 1.45;
  color: var(--dim-paper);
}
.row__src { margin-top: 9px; }

/* The feature row breaks the ledger's rhythm: full bleed and inverted. */
.row--patch {
  background: var(--patch);
  color: var(--on-patch);
  border-top: 0;
  margin-inline: calc(var(--pad) * -1);
  padding-block: 30px 32px;
  padding-inline: var(--pad);
}
.row--patch .row__label { color: var(--accent-patch); }
.row--patch .row__value { margin-top: 12px; }
.row--patch .value--xl { --size: var(--s7); }
.row--patch .value--l  { --size: var(--s6); }
.row--patch .value--m  { --size: var(--s5); }
.row--patch .value--s  { --size: var(--s4); }
.row--patch .row__unit { color: var(--dim-patch); }
.row--patch .row__detail { color: var(--dim-patch); }
.row--patch .row__src { color: var(--dim-patch); }

/* --- image bands ---------------------------------------------------- */
/* Justified strip: each figure's flex-grow is its aspect ratio, so the widths
   come out proportional and every image lands on the same height without a crop.
   align-self keeps a tall caption from stretching its neighbour's image, and the
   inner flex column keeps the caption inside the figure instead of over it. */
.band {
  display: flex;
  gap: 18px;
  padding-block: 26px;
}
.band figure { display: flex; flex-direction: column; align-self: start; min-width: 0; }
.band figcaption {
  margin-top: 10px;
  font-family: var(--data);
  font-size: 10.5px;
  letter-spacing: 0.05em;
  line-height: 1.5;
  color: var(--dim-paper);
}

/* --- narrative ------------------------------------------------------ */
.essay { padding-block: 10px 6px; }
.section {
  display: grid;
  grid-template-columns: minmax(170px, 280px) 1fr;
  gap: 40px;
  border-top: 1px solid var(--rule-paper);
  padding-block: 24px 28px;
}
.section__heading {
  font-family: var(--display);
  font-weight: 700;
  font-size: var(--s0);
  line-height: 1.08;
  letter-spacing: -0.01em;
  border-inline-start: 2px solid var(--accent-paper);
  padding-inline-start: 14px;
}
.section__body { max-width: 78ch; }
.section__src { margin-top: 12px; }

/* --- apparatus ------------------------------------------------------ */
.apparatus { border-top: 1px solid var(--rule-paper); padding-block: 28px 34px; }
.apparatus__label { margin-bottom: 18px; }
.refs { columns: 2; column-gap: 42px; }
.refs li { break-inside: avoid; margin-bottom: 14px; font-size: 13.5px; line-height: 1.4; }
.refs__meta {
  display: block;
  font-family: var(--data);
  font-size: 10.5px;
  letter-spacing: 0.05em;
  color: var(--dim-paper);
  margin-top: 3px;
  overflow-wrap: anywhere;
}

/* --- colophon ------------------------------------------------------- */
/* Legally load-bearing: this is where CC BY / BY-SA attribution is discharged,
   in a PNG where a link would be useless. It stays big enough to read and to
   retype. */
.colophon {
  background: var(--patch);
  color: var(--on-patch);
  padding-block: 32px 36px;
}
.colophon__label { margin-bottom: 20px; }
.credits {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
  gap: 14px 36px;
}
.credit {
  border-top: 1px solid var(--rule-patch);
  padding-top: 12px;
  font-size: 13px;
  line-height: 1.45;
}
.credit__license {
  font-family: var(--data);
  font-size: 11.5px;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--accent-patch);
}
.credit__work { color: var(--on-patch); }
.credit__author { color: var(--dim-patch); }
.credit__adapted { display: block; color: var(--dim-patch); text-transform: none; letter-spacing: 0.04em; }
/* text-transform is inherited, and a licence URI has to be transcribed by hand
   out of the PNG -- uppercasing it would break it. */
.credit__url {
  display: block;
  font-family: var(--data);
  font-size: 10.5px;
  letter-spacing: 0.03em;
  text-transform: none;
  color: var(--dim-patch);
  margin-top: 3px;
  overflow-wrap: anywhere;
}
</style>
</head>
<body>
<div class="rule"></div>

<header class="masthead on-ink{{ ' masthead--flat' if not page.hero else '' }}">
  <div class="masthead__text gutter">
    <h1 class="title fitted title--{{ page.title_scale }}" style="--fit: {{ page.title_fit }}">{{ page.title }}</h1>
    {% if page.subtitle %}
    <p class="subtitle">{{ page.subtitle }}</p>
    {% endif %}
  </div>
  {% if page.hero %}
  <figure class="hero">
    <img src="{{ page.hero.data_uri }}" alt="{{ page.hero.alt }}">
    {# No caption means nothing to darken the image for. #}
    {% if page.hero.caption %}
    <figcaption class="hero__credit">{{ page.hero.caption }}</figcaption>
    {% endif %}
  </figure>
  {% endif %}
</header>

{% if page.summary %}
<section class="lede on-ink gutter">
  <p>{{ page.summary }}</p>
</section>
{% endif %}

{% for block in page.ledger %}
<section class="ledger">
  {% for stat in block %}
  <div class="row{{ ' row--full' if stat.full_width }}{{ ' row--patch on-ink' if stat.feature }}">
    <div class="row__head">
      <p class="row__label">{{ stat.label }}</p>
      <p class="row__value fitted value--{{ stat.scale }}" style="--fit: {{ stat.fit }}">{{ stat.value }}
        {%- if stat.unit %}<span class="row__unit">{{ stat.unit }}</span>{% endif %}</p>
    </div>
    <div class="row__detail">
      {% if stat.detail %}<p>{{ stat.detail }}</p>{% endif %}
      {% if stat.attribution %}<p class="row__src tick">{{ stat.attribution }}</p>{% endif %}
    </div>
  </div>
  {% endfor %}
</section>
{% if loop.first and page.band %}
{{ band(page.band) }}
{% endif %}
{% endfor %}

{% if not page.ledger and page.band %}
{{ band(page.band) }}
{% endif %}

{% if page.sections %}
<div class="essay">
  {% for section in page.sections %}
  <section class="section gutter">
    <h2 class="section__heading">{{ section.heading }}</h2>
    <div class="section__body">
      <p>{{ section.body }}</p>
      {% if section.attributions %}
      <p class="section__src tick">{{ section.attributions | join(' · ') }}</p>
      {% endif %}
    </div>
  </section>
  {% endfor %}
</div>
{% endif %}

{% if page.references %}
<section class="apparatus gutter">
  <p class="apparatus__label tick">Sources</p>
  <ul class="refs">
    {% for reference in page.references %}
    <li>
      {{ reference.title }}
      <span class="refs__meta">
        {%- if reference.publisher %}{{ reference.publisher }} — {% endif -%}
        {{ reference.url }}
      </span>
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if page.credits %}
<footer class="colophon on-ink gutter">
  <p class="colophon__label tick">Image credits</p>
  <div class="credits">
    {% for credit in page.credits %}
    <div class="credit">
      <p class="credit__license">
        {{ credit.license }}
        {% if credit.adapted %}<span class="credit__adapted">adapted from the original</span>{% endif %}
        {% if credit.license_url %}<span class="credit__url">{{ credit.license_url }}</span>{% endif %}
      </p>
      <p>
        {% if credit.work %}<span class="credit__work">{{ credit.work }}</span>{% endif %}
        {% if credit.author %}<span class="credit__author"> — {{ credit.author }}</span>{% endif %}
        {% if credit.source_url %}<span class="credit__url">{{ credit.source_url }}</span>{% endif %}
      </p>
    </div>
    {% endfor %}
  </div>
</footer>
{% endif %}
</body>
</html>
